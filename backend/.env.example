# --- AssemblyAI ---
# API key for real-time streaming STT (keep secret!).
ASSEMBLYAI_API_KEY=

# Speech model used on the Universal-Streaming endpoint.
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro

# real -> stream to AssemblyAI (requires ASSEMBLYAI_API_KEY)
# mock -> deterministic fake transcripts for local dev/tests (no key needed)
STT_MODE=real

# --- LLM (Part 2) ---
# real -> call the Groq free tier (requires GROQ_API_KEY)
# mock -> deterministic fake agent replies for local dev/tests (no key needed)
LLM_MODE=real

# OpenAI-compatible provider. Only "groq" is wired today; the backend keeps the
# provider behind the LLMProvider interface so more can be added later.
LLM_PROVIDER=groq

# Groq API key, created at https://console.groq.com/keys (starts with gsk_).
GROQ_API_KEY=

# Fast, good-quality model on the Groq free tier.
LLM_MODEL=llama-3.3-70b-versatile

# Generation knobs.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=30
# Bounded conversation history sent to the LLM per turn.
MAX_CONTEXT_MESSAGES=24

# Allowed browser origin (CORS + WebSocket).
FRONTEND_ORIGIN=http://localhost:3000

# Logging verbosity.
LOG_LEVEL=INFO