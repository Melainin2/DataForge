# --- AssemblyAI ---
# API key for real-time streaming STT (keep secret!).
ASSEMBLYAI_API_KEY=

# Speech model used on the Universal-Streaming endpoint.
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro

# real -> stream to AssemblyAI (requires ASSEMBLYAI_API_KEY)
# mock -> deterministic fake transcripts for local dev/tests (no key needed)
STT_MODE=real

# Allowed browser origin (CORS + WebSocket).
FRONTEND_ORIGIN=http://localhost:3000

# Logging verbosity.
LOG_LEVEL=INFO