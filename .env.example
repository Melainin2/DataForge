# --- Backend ---
# Copy to backend/.env and fill in your keys.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
STT_MODE=real

# LLM (Part 2): Groq free tier. Use LLM_MODE=mock for a keyless local fake.
LLM_MODE=real
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=30
MAX_CONTEXT_MESSAGES=24

FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# --- Frontend ---
# Copy to frontend/.env.local (no secrets here — the key stays on the backend).
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/voice